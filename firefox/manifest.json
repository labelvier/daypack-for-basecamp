{
  "manifest_version": 3,
  "name": "Backpack by Label Vier",
  "version": "1.0.1",
  "description": "All your Basecamp tools, always at hand in your backpack. Filter kanban boards, manage tasks, and stay organized.",
  "content_scripts": [
    {
      "matches": ["https://3.basecamp.com/*"],
      "js": ["shared/content.js"],
      "css": ["shared/content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "backpack@labelvier.nl",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
