{
  "manifest_version": 3,
  "name": "Daypack by Label Vier",
  "version": "2.1.0",
  "description": "All your Basecamp tools, always at hand in your daypack. Filter kanban boards, manage tasks, and stay organized.",
  "content_scripts": [
    {
      "matches": ["https://3.basecamp.com/*", "https://app.basecamp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
