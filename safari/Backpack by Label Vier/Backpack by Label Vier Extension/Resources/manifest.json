{
  "manifest_version": 3,
  "name": "Backpack by Label Vier",
  "version": "1.0.0",
  "description": "All your Basecamp tools, always at hand in your backpack. Filter kanban boards, manage tasks, and stay organized.",
  "content_scripts": [
    {
      "matches": ["https://3.basecamp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/toolbar-icon-16.png",
      "19": "icons/toolbar-icon-19.png",
      "32": "icons/toolbar-icon-32.png",
      "38": "icons/toolbar-icon-38.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
